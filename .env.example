# ── Supabase (배포에 필수) ────────────────────────────────────
# 이 둘이 비어 있으면 앱은 인메모리 모드로 뜬다. 로컬 개발에는 편하지만
# Vercel 같은 서버리스에서는 인스턴스마다 상태가 갈려서 못 쓴다.
#
# Supabase 대시보드 > Project Settings > Data API 에서 URL,
# Project Settings > API Keys 에서 service_role 키를 복사한다.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Gemini (선택) ────────────────────────────────────────────
# 없으면 미션이 템플릿 라이브러리에서 나온다. 퀴즈는 원래 LLM을 쓰지 않으므로
# 키가 없어도 전체 플로우는 그대로 완주된다.
# 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
